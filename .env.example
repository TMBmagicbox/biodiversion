NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Secreta: NUNCA debe llevar el prefijo NEXT_PUBLIC_ (no se manda al navegador).
# Se obtiene en Supabase: Settings > API Keys > "secret key" (o "service_role" en proyectos antiguos).
# Se usa solo en el servidor para crear usuarios del personal desde /admin/usuarios.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
